# 依赖
node_modules/
__pycache__/
*.egg-info/

# 构建产物
dist/
dist-verify/
build/
target/
.vite/

# 环境与敏感信息
.env
.env.local
*.pem
*.key

# IDE / 系统
.idea/
.vscode/
!.vscode/extensions.json
.DS_Store
Thumbs.db

# 日志
*.log
logs/

# 数据库本地数据 / 本地备份
*.sql.bak
mysql-data/
backup/
backups/

# 部署后的 Hero 上传文件独立保存，前端构建不覆盖
/var/hero-assets/
/var/site-assets/
/var/build/

# 审计原始产物 / 会话临时目录
.audit/
.workbuddy/tmp/

# 本地素材（OP 视频 / 原图 / 参考图，不入库，避免仓库膨胀）
assets-src/

# 未核实分发授权的素材仅保留本地；来源与哈希见 docs/assets-manifest.csv
/frontend/public/assets/*.mp4
/frontend/public/assets/*-poster.jpg
/frontend/public/img/
/frontend/public/favicon.ico
/docs/img/

# 私人过程记录（本地保留，不入库）
.workbuddy/
